<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>TireMark</AssemblyName>
    <RootNamespace>TireMark</RootNamespace>
    <Product>TireMark</Product>
    <ApplicationIcon>Assets/TireMarkBrand.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets/TireMarkBrand.ico;Assets/TireMarkBrand.png" />
    <Resource Include="Assets/TireMarkBrand.ico" />
    <Resource Include="Assets/TireMarkBrand.png" />
    <EmbeddedResource Include="Assets/Localization.generated.json" LogicalName="TireMark.Localization.generated.json" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>
</Project>
